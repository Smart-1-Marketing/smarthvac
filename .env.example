# Copy to .env for local development. Do NOT commit a real .env or API key.

# Required — your OpenAI API key
OPENAI_API_KEY=sk-...

# Model used to generate the report (any model available in your OpenAI account)
OPENAI_MODEL=gpt-4.1-mini

# Smart 1 Suite (GoHighLevel) inbound webhook URL. Leave blank to disable lead delivery.
SMART1_WEBHOOK_URL=

# Absolute base URL of the deployed app, so report PDF links are absolute.
# e.g. https://smart1hvac.onrender.com  (leave blank locally to derive from the request)
PUBLIC_BASE_URL=

# Set to 0 to disable branded PDF generation
ENABLE_PDF=1
